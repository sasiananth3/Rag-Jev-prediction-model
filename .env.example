# OpenRouter generation; defaults to OpenRouter free-model router
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# JEV evaluation endpoint and key (match your provider's API contract)
JEV_API_URL=
JEV_API_KEY=

# Local vector retrieval settings
CHROMA_PERSIST_DIRECTORY=chroma_db
CHROMA_COLLECTION=pdf_knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
